ENVIRONMENT=development
LOG_LEVEL=INFO

COHERE_API_KEY=your-cohere-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=rag-portfolio

# Use Neon's POOLED host (contains "-pooler") and the asyncpg driver.
# Neon gives "postgresql://...?sslmode=require": change the scheme to
# "postgresql+asyncpg://" and replace "sslmode=require" with "ssl=require".
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?ssl=require

# Vendor rate limits (0 = unlimited). Cohere TRIAL keys allow ~20 chat and ~10 rerank calls per minute.
# Setting these makes the service wait for a free slot instead of failing with HTTP 503.
LLM_CALLS_PER_MINUTE=0
RERANK_CALLS_PER_MINUTE=0

# Answer LLM. "cohere" uses COHERE_API_KEY and LLM_MODEL (default command-a-03-2025).
# To use another provider (Groq, Google Gemini, OpenRouter, OpenAI...), switch to openai_compatible:
LLM_PROVIDER=cohere
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-provider-key
# LLM_MODEL=llama-3.3-70b-versatile
# Optional: a different model for the evaluation judge
# JUDGE_MODEL=
